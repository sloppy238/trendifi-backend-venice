# Required for MySQL/TiDB and Drizzle migrations
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Session/auth configuration
JWT_SECRET=replace-with-a-long-random-secret
VITE_APP_ID=replace-with-your-app-id
OAUTH_SERVER_URL=https://api.manus.im
OWNER_OPEN_ID=replace-with-owner-open-id

# Manus built-in API access
BUILT_IN_FORGE_API_URL=https://replace-with-forge-api
BUILT_IN_FORGE_API_KEY=replace-with-forge-api-key

NODE_ENV=development
PORT=3000
